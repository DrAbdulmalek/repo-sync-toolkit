_url": "https://api.github.com/users/DrAbdulmalek/subscriptions", "organizations_url": "https://api.github.com/users/DrAbdulmalek/orgs", "repos_url": "https://api.github.com/users/DrAbdulmalek/repos", "events_url": "https://api.github.com/users/DrAbdulmalek/events{/privacy}", "received_events_url": "https://api.github.com/users/DrAbdulmalek/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "body": "## \u0645\u0627\u0630\u0627 \u064a\u0636\u064a\u0641 \u0647\u0630\u0627 \u0627\u0644\u0641\u0631\u0639\n`LICENSES.json` (\u0633\u064a\u0627\u0633\u0629 \u0627\u0644\u062d\u0633\u0627\u0628): \u0627\u0644\u0645\u0633\u0645\u0648\u062d (MIT/Apache/BSD/ISC/MPL)\u060c \u0627\u0644\u0645\u0631\u0627\u062c\u0639\u0629 (LGPL/EPL/CDDL)\u060c \u0627\u0644\u0645\u0645\u0646\u0648\u0639 \u0643\u062a\u0628\u0639\u064a\u0629 (GPL-2/3, AGPL-3.0)\u060c \u0627\u0644\u0645\u0645\u0646\u0648\u0639 \u0627\u0633\u062a\u062e\u062f\u0627\u0645\u064b\u0627 (CC-BY-NC-*\u060c \u063a\u064a\u0631 \u062a\u062c\u0627\u0631\u064a)\u060c \u0648\u0642\u0627\u0626\u0645\u0629 \u0645\u0631\u0627\u0642\u0628\u0629 \u0644\u064014 \u0645\u0631\u0634\u062d \u062a\u0643\u0627\u0645\u0644 \u062e\u0627\u0631\u062c\u064a \u0645\u0639 \u0648\u0636\u0639 \u0627\u0644\u0627\u0633\u062a\u0647\u0644\u0627\u0643 \u0627\u0644\u0645\u0639\u062a\u0645\u062f (Surya=service \u0641\u0642\u0637\u060c OBLITERATUS=CLI \u0641\u0642\u0637\u060c Jina=\u062a\u062c\u0627\u0631\u0628 \u063a\u064a\u0631 \u062a\u062c\u0627\u0631\u064a\u0629\u060c \u0648\u0627\u0644\u0628\u0642\u064a\u0629 `verify_before_integration`).\n\n`license_audit.py`: \u062c\u0631\u062f \u062a\u0631\u0627\u062e\u064a\u0635 \u0645\u0633\u062a\u0648\u062f\u0639\u0627\u062a \u0627\u0644\u0645\u0627\u0644\u0643 + \u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u0645\u0631\u0627\u0642\u0628\u0629 \u0639\u0628\u0631 GitHub API (\u062a\u0648\u0643\u0646 \u0645\u0646 env \u0641\u0642\u0637\u060c \u0644\u0627 \u064a\u0637\u0628\u0639 \u0648\u0644\u0627 \u064a\u064f\u062e\u0632\u0646)\u060c \u062a\u0635\u0646\u064a\u0641 \u0648\u0642\u0648\u0627\u0639\u062f: \u062a\u0631\u062e\u064a\u0635 \u0645\u0645\u0646\u0648\u0639 \u0628\u0648\u0636\u0639 `library` = \u0645\u062e\u0627\u0644\u0641\u0629 (\u062e\u0631\u0648\u062c 1)\u060c fork \u0645\u0645\u0646\u0648\u0639/\u0628\u0644\u0627 \u062a\u0631\u062e\u064a\u0635 = \u062a\u062d\u0630\u064a\u0631\u060c `--json` \u0644\u0644\u062a\u0634\u063a\u064a\u0644 \u0627\u0644\u0644\u064a\u0644\u064a\u060c `--selftest` \u0628\u0644\u0627 \u0634\u0628\u0643\u0629.\n\n## \u0627\u0644\u0623\u062f\u0644\u0629\n- selftest: 22/22 \u0646\u0627\u062c\u062d\u0629 (5 \u0645\u062e\u0627\u0644\u0641\u0627\u062a/8 \u062a\u062d\u0630\u064a\u0631\u0627\u062a \u0641\u064a \u0645\u062d\u0641\u0638\u0629 \u0648\u0647\u0645\u064a\u0629\u060c \u0642\u0648\u0627\u0639\u062f \u0627\u0644\u062d\u0627\u062c\u0632 \u062a\u0637\u0644\u0642\u060c \u0627\u0644\u0645\u062d\u0641\u0638\u0629 \u0627\u0644\u0646\u0638\u064a\u0641\u0629 \u062e\u0631\u0648\u062c 0).\n- \u0635\u0641\u0631 \u062a\u0628\u0639\u064a\u0627\u062a \u062e\u0627\u0631\u062c\u064a\u0629 (stdlib \u0641\u0642\u0637) \u2014 \u0645\u0646\u0627\u0633\u0628 \u0644\u0644\u062c\u062f\u0648\u0644\u0629 \u0627\u0644\u0644\u064a\u0644\u064a\u0629 \u0639\u0628\u0631 master_orchestrator.\n\n\u0627\u0644\u0645\u0631\u062c\u0639: \u0628\u0646\u062f \u0627\u0644\u0623\u0648\u0644\u0648\u064a\u0629 5 \u0641\u064a \u00ab\u062e\u0627\u0631\u0637\u0629 \u062a\u0637\u0648\u064a\u0631 \u0645\u062a\u0643\u0627\u0645\u0644\u0629 \u0644\u0645\u0634\u0627\u0631\u064a\u0639 \u0627\u0644\u062d\u0633\u0627\u0628\u00bb \u2014 \u0627\u0644\u0642\u0627\u0639\u062f\u0629: \u0627\u0644\u0645\u0643\u062a\u0628\u0627\u062a \u0627\u0644\u0645\u0644\u0648\u062b\u0629 \u062a\u064f\u0633\u062a\u062f\u0639\u0649 \u0639\u0645\u0644\u064a\u0627\u062a \u0645\u0646\u0641\u0635\u0644\u0629 \u062a\u062a\u0628\u0627\u062f\u0644 \u0645\u0644\u0641\u0627\u062a\u060c \u0644\u0627 \u0627\u0633\u062a\u064a\u0631\u0627\u062f \u062f\u0627\u062e\u0644 \u0645\u0634\u0627\u0631\u064a\u0639 MIT.", "labels": [], "milestone": null, "active_lock_reason": null, "created_at": "2026-11-22T20:36:16Z", "updated_at": "2026-11-22T20:36:16Z", "closed_at": null, "merged_at": null, "merge_commit_sha": "4e552a9e462106568a0e4498e99b85befc688d6b", "assignee": null, "assignees": [], "requested_reviewers": [], "requested_teams": [], "head": {"label": "DrAbdulmalek:roadmap/license-audit", "ref": "roadmap/license-audit", "repo": {"id": 1283409898, "node_id": "R_kgDOTH9H6g", "name": "repo-sync-toolkit", "full_name": "DrAbdulmalek/repo-sync-toolkit", "owner": {"login": "DrAbdulmalek", "id": 101952860, "node_id": "U_kgDOBhOtXA", "avatar_url": "https://avatars.githubusercontent.com/u/101952860?v=4", "gravatar_id": "", "url": "https://api.github.com/users/DrAbdulmalek", "html_url": "https://github.com/DrAbdulmalek", "followers_url": "https://api.github.com/users/DrAbdulmalek/followers", "following_url": "https://api.github.com/users/DrAbdulmalek/following{/other_user}", "gists_url": "https://api.github.com/users/DrAbdulmalek/gists{/gist_id}", "starred_url": "https://api.github.com/users/DrAbdulmalek/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/DrAbdulmalek/subscriptions", "organizations_url": "https://api.github.com/users/DrAbdulmalek/orgs", "repos_url": "https://api.github.com/users/DrAbdulmalek/repos", "events_url": "https://api.github.com/users/DrAbdulmalek/events{/privacy}", "received_events_url": "https://api.github.com/users/DrAbdulmalek/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "private": false, "fork": false, "archived": false, "disabled": false, "description": "Secure Git Synchronization \u2014 28 repos + 11 HF Spaces, token manager, TUI dashboard", "homepage": null, "language": "Python", "visibility": "public", "is_template": false, "topics": ["automation", "devops", "github", "sync", "tool