niFile_Processor/pulls/3", "id": 4964357041, "node_id": "PR_kwDOTa6B588AAAABJ-YTsQ", "html_url": "https://github.com/DrAbdulmalek/OmniFile_Processor/pull/3", "diff_url": "https://github.com/DrAbdulmalek/OmniFile_Processor/pull/3.diff", "patch_url": "https://github.com/DrAbdulmalek/OmniFile_Processor/pull/3.patch", "issue_url": "https://api.github.com/repos/DrAbdulmalek/OmniFile_Processor/issues/3", "commits_url": "https://api.github.com/repos/DrAbdulmalek/OmniFile_Processor/pulls/3/commits", "review_comments_url": "https://api.github.com/repos/DrAbdulmalek/OmniFile_Processor/pulls/3/comments", "review_comment_url": "https://api.github.com/repos/DrAbdulmalek/OmniFile_Processor/pulls/comments{/number}", "comments_url": "https://api.github.com/repos/DrAbdulmalek/OmniFile_Processor/issues/3/comments", "statuses_url": "https://api.github.com/repos/DrAbdulmalek/OmniFile_Processor/statuses/9302b26fac5a2d62788925c54c88b05009bf325c", "number": 3, "state": "open", "locked": false, "title": "chore: add security policy, Dependabot, and PR template", "user": {"login": "DrAbdulmalek", "id": 101952860, "node_id": "U_kgDOBhOtXA", "avatar_url": "https://avatars.githubusercontent.com/u/101952860?v=4", "gravatar_id": "", "url": "https://api.github.com/users/DrAbdulmalek", "html_url": "https://github.com/DrAbdulmalek", "followers_url": "https://api.github.com/users/DrAbdulmalek/followers", "following_url": "https://api.github.com/users/DrAbdulmalek/following{/other_user}", "gists_url": "https://api.github.com/users/DrAbdulmalek/gists{/gist_id}", "starred_url": "https://api.github.com/users/DrAbdulmalek/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/DrAbdulmalek/subscriptions", "organizations_url": "https://api.github.com/users/DrAbdulmalek/orgs", "repos_url": "https://api.github.com/users/DrAbdulmalek/repos", "events_url": "https://api.github.com/users/DrAbdulmalek/events{/privacy}", "received_events_url": "https://api.github.com/users/DrAbdulmalek/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "body": "## What\n\nAdds the governance and dependency-automation files this repository was missing. Each file is its own commit so it can be reverted independently.\n\n### Commits\n\n- `44573e608` - chore: add Dependabot configuration (`.github/dependabot.yml`)\n- `e8425c653` - docs: add SECURITY.md (`SECURITY.md`)\n- `9302b26fa` - docs: add pull request template (`.github/PULL_REQUEST_TEMPLATE.md`)\n\n### Why\n\n- **`.github/dependabot.yml`** - opens weekly grouped update PRs for GitHub Actions and the detected package ecosystem, so vulnerable dependencies surface automatically instead of silently.\n- **`SECURITY.md`** - gives reporters a private channel and sets response expectations; it also documents the rotate-first rule for leaked credentials.\n- **`PULL_REQUEST_TEMPLATE.md`** - adds a secrets/large-artifact checklist to every future PR.\n\n> Nothing in this PR changes application code or CI behaviour.\n\n## How to revert\n\n- Close this PR without merging, or revert individual commits:\n  ```bash\n  git revert 44573e608f73580453bc7114429851961284161d   # chore: add Dependabot configuration\n  git revert e8425c653349c86ca7639f6406f567ad7e7820d2   # docs: add SECURITY.md\n  git revert 9302b26fac5a2d62788925c54c88b05009bf325c   # docs: add pull request template\n  ```\n\nGenerated 2026-10-22.", "labels": [], "milestone": null, "active_lock_reason": null, "created_at": "2026-10-22T08:22:46Z", "updated_at": "2026-10-22T08:22:46Z", "closed_at": null, "merged_at": null, "merge_commit_sha": "bdfad29376bd4a55bcd3ff445f7c0e874f9da74a", "assignee": null, "assignees": [], "requested_reviewers": [], "requested_teams": [], "head": {"label": "DrAbdulmalek:chore/repo-governance", "ref": "chore/repo-governance", "repo": {"id": 1303282151, "node_id": "R_kgDOTa6B5w", "name": "OmniFile_Processor", "full_name": "DrAbdulmalek/OmniFile_Processor", "owner": {"login": "DrAbdulmalek", "id": 101952860, "node_i