sers/DrAbdulmalek/subscriptions", "organizations_url": "https://api.github.com/users/DrAbdulmalek/orgs", "repos_url": "https://api.github.com/users/DrAbdulmalek/repos", "events_url": "https://api.github.com/users/DrAbdulmalek/events{/privacy}", "received_events_url": "https://api.github.com/users/DrAbdulmalek/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "body": "## \u0645\u0627\u0630\u0627 \u064a\u0636\u064a\u0641 \u0647\u0630\u0627 \u0627\u0644\u0641\u0631\u0639\n\u0647\u064a\u0643\u0644 \u062d\u0632\u0645\u0629 \u062a\u0648\u0632\u064a\u0639 \u062f\u0627\u062e\u0644\u064a\u0629 `packages/omnifile-core` \u062a\u0639\u064a\u062f \u062a\u0635\u062f\u064a\u0631 \u0627\u0644\u0645\u0646\u0637\u0642 \u0627\u0644\u0642\u0627\u0628\u0644 \u0644\u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645 (`modules/nlp` + `modules/evaluation` + `modules/export`) \u0628\u0627\u0633\u0645 `omnifile_core` \u0628\u0637\u0628\u0642\u0629 \u062a\u062d\u0645\u064a\u0644 \u0643\u0633\u0648\u0644 (PEP 562) \u0628\u0644\u0627 \u062a\u0628\u0639\u064a\u0627\u062a \u0648\u0642\u062a \u0627\u0644\u0627\u0633\u062a\u064a\u0631\u0627\u062f \u2014 \u0644\u064a\u0633\u062a\u0647\u0644\u0643\u0647\u0627 IntelliFile \u0648marathon \u0648medical-rag-ar \u0645\u0646 \u0645\u0635\u062f\u0631 \u0648\u0627\u062d\u062f \u0628\u062f\u0644 \u0646\u0633\u062e \u0627\u0644\u0645\u0644\u0641\u0627\u062a.\n\n## \u0627\u0644\u0623\u062f\u0644\u0629\n- 47 \u0627\u062e\u062a\u0628\u0627\u0631 \u0646\u0627\u062c\u062d: \u0648\u062c\u0648\u062f/\u0646\u0648\u0639 \u0627\u0644\u064033 \u0627\u0633\u0645\u064b\u0627 \u0627\u0644\u0645\u0639\u0627\u062f \u062a\u0635\u062f\u064a\u0631\u0647\u0627 (\u0643\u0644\u0647\u0627 \u0623\u0633\u0645\u0627\u0621 \u062d\u0642\u064a\u0642\u064a\u0629 \u0645\u0646 \u0627\u0644\u0643\u0648\u062f)\u060c \u062a\u062d\u0645\u064a\u0644 correction_dict (97 \u0625\u062f\u062e\u0627\u0644\u064b\u0627)\u060c \u062f\u062e\u0627\u0646 \u0648\u0638\u064a\u0641\u064a \u0644\u0644\u062a\u0637\u0628\u064a\u0639 \u0648RTL \u0648CER/WER \u0648\u0627\u0644\u062a\u0635\u062d\u064a\u062d \u0648\u0627\u0644\u062a\u0635\u062f\u064a\u0631.\n- wheel \u064a\u064f\u0628\u0646\u0649 \u0628\u0646\u062c\u0627\u062d\u061b \u0627\u0644\u0627\u0633\u062a\u064a\u0631\u0627\u062f \u0628\u0644\u0627 pandas/torch/openai.\n\n## \u0627\u0643\u062a\u0634\u0627\u0641 \u0645\u0647\u0645 \u0644\u0644\u0645\u0634\u0631\u0641\n`modules/nlp/__init__.py` \u0645\u0643\u0633\u0648\u0631 \u062d\u0627\u0644\u064a\u064b\u0627: \u064a\u0633\u062a\u0648\u0631\u062f `spell_corrector` \u0648\u0645\u0644\u0641\u0647 \u063a\u064a\u0631 \u0645\u0648\u062c\u0648\u062f \u0639\u0644\u0649 \u0627\u0644\u0642\u0631\u0635 \u2014 \u0623\u064a `import modules.nlp.*` \u064a\u0641\u0634\u0644 \u0627\u0644\u064a\u0648\u0645. \u0627\u0644\u0637\u0628\u0642\u0629 \u062a\u062a\u062c\u0627\u0648\u0632\u0647 \u0628\u062a\u062d\u0645\u064a\u0644 \u0627\u0644\u0645\u0644\u0641\u0627\u062a \u0645\u0628\u0627\u0634\u0631\u0629\u060c \u0648\u064a\u064f\u0648\u0635\u0649 \u0628\u0625\u0639\u0627\u062f\u0629 \u0625\u0646\u0634\u0627\u0621 \u0627\u0644\u0645\u0644\u0641 (\u0627\u0644\u0645\u062a\u0627\u0628\u0639\u0629 #1 \u0641\u064a README).\n\n## \u0645\u062a\u0627\u0628\u0639\u0627\u062a\n1. \u0625\u0635\u0644\u0627\u062d `spell_corrector.py` \u0627\u0644\u0645\u0641\u0642\u0648\u062f \u062b\u0645 \u0625\u0636\u0627\u0641\u0629 `SpellCorrector` \u0644\u0644\u062a\u0635\u062f\u064a\u0631\u0627\u062a.\n2. \u0625\u062a\u0645\u0627\u0645 \u0627\u0644\u0627\u0633\u062a\u062e\u0631\u0627\u062c \u0627\u0644\u0641\u064a\u0632\u064a\u0627\u0626\u064a \u0644\u0627\u062d\u0642\u064b\u0627 \u0648\u0625\u0633\u0642\u0627\u0637 fallback \u0627\u0644\u062a\u062d\u0645\u064a\u0644 \u0627\u0644\u0645\u0628\u0627\u0634\u0631.\n3. \u0631\u0641\u0639 \u0642\u0627\u0645\u0648\u0633 \u0627\u0644\u062a\u0635\u062d\u064a\u062d \u0641\u0648\u0642 100 \u0625\u062f\u062e\u0627\u0644 (97 \u062d\u0627\u0644\u064a\u064b\u0627).\n\n\u0627\u0644\u0645\u0631\u062c\u0639: \u0628\u0646\u062f \u0627\u0644\u0623\u0648\u0644\u0648\u064a\u0629 2 \u0641\u064a \u00ab\u062e\u0627\u0631\u0637\u0629 \u062a\u0637\u0648\u064a\u0631 \u0645\u062a\u0643\u0627\u0645\u0644\u0629 \u0644\u0645\u0634\u0627\u0631\u064a\u0639 \u0627\u0644\u062d\u0633\u0627\u0628\u00bb.", "labels": [], "milestone": null, "active_lock_reason": null, "created_at": "2026-11-22T20:36:07Z", "updated_at": "2026-11-22T20:36:07Z", "closed_at": null, "merged_at": null, "merge_commit_sha": "67229b4f232cc9eb0b925919632b62886860bbc8", "assignee": null, "assignees": [], "requested_reviewers": [], "requested_teams": [], "head": {"label": "DrAbdulmalek:roadmap/omnifile-core-package", "ref": "roadmap/omnifile-core-package", "repo": {"id": 1303282151, "node_id": "R_kgDOTa6B5w", "name": "OmniFile_Processor", "full_name": "DrAbdulmalek/OmniFile_Processor", "owner": {"login": "DrAbdulmalek", "id": 101952860, "node_id": "U_kgDOBhOtXA", "avatar_url": "https://avatars.githubusercontent.com/u/101952860?v=4", "gravatar_id": "", "url": "https://api.github.com/users/DrAbdulmalek", "html_url": "https://github.com/DrAbdulmalek", "followers_url": "https://api.github.com/users/DrAbdulmalek/followers", "following_url": "https://api.github.com/users/DrAbdulmalek/following{/other_user}", "gists_url": "https://api.github.com/users/DrAbdulmalek/gists{/gist_id}", "starred_url": "https://api.github.com/users/DrAbdulmalek/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/DrAbdulmalek/subscriptions", "organizations_url": "https://api.github.com/users/DrAbdulmalek/orgs", "repos_url": "https://api.github.com/users/DrAbdulmalek/repos", "events_url": "https://api.github.com/users/DrAbdulmalek/events{/privacy}", "received_events_url": "https://api.github.com/users/DrAbdulmalek/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "private": false, "fork": false, "archived